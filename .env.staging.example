# =============================================================================
# .env.staging.example — variables d'environnement de l'environnement STAGING
# =============================================================================
# NE PAS committer les vraies valeurs. Ce fichier est un MODELE.
# Les vraies valeurs se posent dans Vercel → Settings → Environment Variables,
# scopées sur l'environnement "Preview" (= branche `staging`), PAS "Production".
#
# Regle d'or : staging ne doit JAMAIS pointer vers la base, Stripe ou Resend
# de production. Tout est isole (projet Supabase staging + Stripe test + Resend).
# =============================================================================

# --- Supabase (projet "axessio-staging", PAS la prod) ---
# Settings → API du projet staging
NEXT_PUBLIC_SUPABASE_URL=https://<ref-staging>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-staging>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-staging>

# --- App ---
# Domaine du staging (doit matcher le Site URL Supabase staging)
NEXT_PUBLIC_APP_URL=https://staging.axessyo.com

# --- Resend (emails) ---
# Utiliser une cle de test / un domaine d'envoi distinct si possible.
RESEND_API_KEY=re_<cle-test>
RESEND_FROM_EMAIL=Axessyo Staging <noreply@send.axessyo.com>

# --- Crons ---
# Secret partage : meme valeur ici ET dans les secrets GitHub Actions (env staging).
CRON_SECRET=<secret-staging>

# --- Stripe (mode TEST uniquement en staging) ---
# Cles sk_test_* et whsec_* d'un webhook pointant vers https://staging.axessyo.com/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_<...>
STRIPE_WEBHOOK_SECRET=whsec_<...>

# --- Rate limiting (optionnel) ---
REDIS_URL=

# --- SEO : laisser VIDE en staging (le site staging doit rester noindex) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Sentry (optionnel) ---
# Si utilise, prefere un environnement Sentry "staging" distinct.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
