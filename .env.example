# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (transactional emails)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Axessyo <noreply@send.axessyo.com>

# App
NEXT_PUBLIC_APP_URL=https://axessyo.com

# Crons (Vercel Cron + GitHub Action webhook-dispatch).
# Secret partagé : la même valeur doit être posée dans Vercel ET dans les
# secrets GitHub Actions. Sans lui, les routes /api/cron/* répondent 503.
CRON_SECRET=

# Rate limiting (Redis) — optionnel.
# Chaîne de connexion redis:// ou rediss:// (Redis Cloud, Vercel Redis, Upstash...).
# Absent → fallback in-memory (OK en dev, NON fiable en multi-instance sur Vercel).
# Présent → compteur global partagé entre toutes les lambdas (mode prod).
REDIS_URL=

# SEO — tokens optionnels de Search Console (laisser vide en local)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Sentry (observabilité) — optionnel.
# Absent → SDK désactivé, la plateforme tourne normalement (mode tolérant).
# Présent → erreurs client + serveur remontées dans Sentry, taggées user/org.
# DSN : Sentry → Settings → Projects → <projet> → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Upload des source maps au build (optionnel, pour des stack traces lisibles) :
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
