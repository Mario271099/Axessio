# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (transactional emails)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Axessio <noreply@axessio.example>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limiting (Upstash Redis, REST) — optionnel.
# Absent → fallback in-memory (OK en dev, NON fiable en multi-instance sur Vercel).
# Présent → compteur global partagé entre toutes les lambdas (mode prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SEO — tokens optionnels de Search Console (laisser vide en local)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
